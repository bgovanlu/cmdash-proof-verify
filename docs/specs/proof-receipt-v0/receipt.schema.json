{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmdash:proof-receipt:v0:schema",
  "title": "CMDash Proof Receipt v0 envelope",
  "description": "Normative text: docs/specs/proof-receipt-v0.md. The root schema is the envelope; validate the decoded payload against #/$defs/payload. A schema checks structure only: it cannot check duplicate member names (a parser's job, spec section 3.4), a signature or a point, the canonical form of the payload bytes, the admissibility arithmetic, key status, the log, or time. Those are the checks of spec section 9. Patterns use ECMA-262 regular expressions in Unicode mode (the u flag), as ajv does by default.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "payload", "sig"],
  "properties": {
    "v": { "const": 0 },
    "payload": {
      "description": "Unpadded base64url (RFC 4648 section 5) of the canonical payload bytes, with zero spare bits in the last character.",
      "type": "string",
      "minLength": 2,
      "maxLength": 21846,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "sig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": { "const": "Ed25519" },
        "kid": { "$ref": "#/$defs/issuerKid" },
        "value": { "$ref": "#/$defs/signature" }
      }
    },
    "log": { "$ref": "#/$defs/logSection" },
    "issuerKey": {
      "description": "Unsigned convenience copy of the issuer public key. A verifier holding only this key says UNVERIFIABLE (spec section 6.6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "alg", "publicKey"],
      "properties": {
        "kid": { "$ref": "#/$defs/issuerKid" },
        "alg": { "const": "Ed25519" },
        "publicKey": { "$ref": "#/$defs/spki" }
      }
    }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "tenantRef": { "type": "string", "pattern": "^tr_[0-9a-f]{32}$" },
    "deployment": {
      "description": "A deployment origin every verifier accepts (spec section 6.2): https with a canonical host (lowercase LDH labels, no empty label, no trailing dot, a last label that starts with a letter, or a canonical IPv4 address) and an optional port of 1..65535 without leading zeros and never 443; or http on localhost or 127.0.0.1, never port 80.",
      "type": "string",
      "pattern": "^(?:https://(?=[a-z0-9.-]{1,253}(?::[0-9]{1,5})?$)(?:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))(?::(?!443$)(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?|http://(?:localhost|127\\.0\\.0\\.1)(?::(?!80$)(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)$"
    },
    "plainHttpDeployment": {
      "description": "A plain-http deployment origin on any canonical host, never port 80 (spec section 6.2): canonical, but its key document is trusted only when the relying party explicitly allows plain http.",
      "type": "string",
      "pattern": "^http://(?=[a-z0-9.-]{1,253}(?::[0-9]{1,5})?$)(?:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))(?::(?!80$)(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "issuingDeployment": {
      "description": "The deployment a payload, a key document or an evidence manifest may name: a canonical origin of either kind.",
      "anyOf": [{ "$ref": "#/$defs/deployment" }, { "$ref": "#/$defs/plainHttpDeployment" }]
    },
    "issuer": {
      "description": "The issuer: the pair (deployment, tenantRef), and the key that signed (spec sections 5.1, 6.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "tenantRef", "keyId"],
      "properties": {
        "deployment": { "$ref": "#/$defs/issuingDeployment" },
        "tenantRef": { "$ref": "#/$defs/tenantRef" },
        "keyId": { "$ref": "#/$defs/issuerKid" }
      }
    },
    "userId": { "type": "string", "pattern": "^[!-~]{1,128}$" },
    "issuerKid": { "type": "string", "pattern": "^cmdash-proof-[0-9a-f]{16}$" },
    "logKid": { "type": "string", "pattern": "^cmdash-proof-log-[0-9a-f]{16}$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "description": "UTC with milliseconds, years 1970-9999. The calendar check (no 30 February) is the checker's round trip; format is an annotation to most validators.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "claimId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "framework": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "controlId": { "type": "string", "pattern": "^[!-~]{1,64}$" },
    "sourceRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "methodId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "unit": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$" },
    "text": {
      "description": "Human text (spec section 5.5): no C0 or C1 controls, no bidi controls or line separators, no default-ignorable code points (zero-width, fillers, tags, variation selectors), no private use. Listed explicitly, never through \\p{...}.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u{0}-\\u{1F}\\u{7F}-\\u{9F}\\u{AD}\\u{34F}\\u{61C}\\u{115F}\\u{1160}\\u{17B4}\\u{17B5}\\u{180B}-\\u{180F}\\u{200B}-\\u{200F}\\u{2028}-\\u{202E}\\u{2060}-\\u{206F}\\u{3164}\\u{E000}-\\u{F8FF}\\u{FE00}-\\u{FE0F}\\u{FEFF}\\u{FFA0}\\u{FFF0}-\\u{FFFB}\\u{1BCA0}-\\u{1BCA3}\\u{1D173}-\\u{1D17A}\\u{E0000}-\\u{E0FFF}\\u{F0000}-\\u{10FFFF}]+$"
    },
    "spki": {
      "description": "Unpadded base64url of the 44-byte DER SubjectPublicKeyInfo of an Ed25519 key. The point itself is checked by the verifier (spec section 2.1.1).",
      "type": "string",
      "pattern": "^MCowBQYDK2VwAyEA[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signature": {
      "description": "Unpadded base64url of a 64-byte Ed25519 signature.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "origin": {
      "description": "A transparency log origin and signed-note key name: printable ASCII without space or plus.",
      "type": "string",
      "pattern": "^[!-*,-~]{1,255}$"
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "scoreInt": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
    "treeSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/methodId" },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "selfAttested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byRole", "at"],
      "properties": {
        "byRole": { "$ref": "#/$defs/role" },
        "at": { "$ref": "#/$defs/timestamp" }
      }
    },

    "payload": {
      "description": "The signed payload (spec section 5), as decoded from the envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "issuer", "claim", "sources", "observedAt", "issuedAt", "freshUntil", "evidence"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/ulid" },
        "issuer": { "$ref": "#/$defs/issuer" },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimId", "statement", "controls", "assertion"],
          "properties": {
            "claimId": { "$ref": "#/$defs/claimId" },
            "statement": { "$ref": "#/$defs/text", "maxLength": 500 },
            "controls": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["framework", "controlId"],
                "properties": {
                  "framework": { "$ref": "#/$defs/framework" },
                  "controlId": { "$ref": "#/$defs/controlId" }
                }
              }
            },
            "assertion": { "$ref": "#/$defs/assertion" }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator", "unknown", "scope", "method"],
          "properties": {
            "numerator": { "$ref": "#/$defs/count" },
            "denominator": { "$ref": "#/$defs/count" },
            "unknown": { "$ref": "#/$defs/count" },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "description"],
              "properties": {
                "unit": { "$ref": "#/$defs/unit" },
                "description": { "$ref": "#/$defs/text", "maxLength": 300 }
              }
            },
            "method": { "$ref": "#/$defs/method" }
          }
        },
        "selfAttested": { "$ref": "#/$defs/selfAttested" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["INTEGRATION", "COLLECTOR", "TENANT_RECORD", "PERSON"] },
              "ref": { "$ref": "#/$defs/sourceRef" }
            }
          }
        },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "freshUntil": { "$ref": "#/$defs/timestamp" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algo", "commitment"],
          "properties": {
            "algo": { "const": "sha256-salted" },
            "commitment": { "$ref": "#/$defs/hex32" }
          }
        },
        "supersedes": { "$ref": "#/$defs/ulid" }
      },
      "if": {
        "properties": { "claim": { "properties": { "assertion": { "properties": { "kind": { "const": "SELF_ATTESTED" } } } } } }
      },
      "then": {
        "required": ["selfAttested"],
        "not": { "required": ["measurement"] },
        "properties": { "sources": { "items": { "properties": { "kind": { "const": "PERSON" }, "ref": { "const": "self-attestation" } } } } }
      },
      "else": {
        "required": ["measurement"],
        "not": { "required": ["selfAttested"] },
        "properties": { "sources": { "items": { "properties": { "kind": { "not": { "const": "PERSON" } } } } } }
      }
    },

    "assertion": {
      "description": "The structured claim (spec section 5.3). The statement text never overrides it.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "ALL" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "threshold"],
          "properties": {
            "kind": { "const": "AT_LEAST" },
            "threshold": {
              "type": "object",
              "additionalProperties": false,
              "required": ["numerator", "denominator"],
              "properties": {
                "numerator": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "denominator": { "type": "integer", "minimum": 2, "maximum": 1000000 }
              }
            }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "RATIO" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "min", "max"],
          "properties": {
            "kind": { "const": "SCORE" },
            "value": { "$ref": "#/$defs/scoreInt" },
            "min": { "$ref": "#/$defs/scoreInt" },
            "max": { "$ref": "#/$defs/scoreInt" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "SELF_ATTESTED" } } }
      ]
    },

    "issuerKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "alg", "publicKey", "status", "validFrom"],
      "properties": {
        "kid": { "$ref": "#/$defs/issuerKid" },
        "alg": { "const": "Ed25519" },
        "publicKey": { "$ref": "#/$defs/spki" },
        "status": { "enum": ["ACTIVE", "RETIRED", "REVOKED"] },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "revokedAt": { "$ref": "#/$defs/timestamp" },
        "revocationReason": { "enum": ["KEY_COMPROMISE", "ISSUER_REQUEST"] },
        "lastTreeSize": { "$ref": "#/$defs/treeSize" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ACTIVE" } } },
          "then": {
            "not": {
              "anyOf": [{ "required": ["validUntil"] }, { "required": ["revokedAt"] }, { "required": ["revocationReason"] }, { "required": ["lastTreeSize"] }]
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "RETIRED" } } },
          "then": { "required": ["validUntil"], "not": { "anyOf": [{ "required": ["revokedAt"] }, { "required": ["revocationReason"] }] } }
        },
        {
          "if": { "properties": { "status": { "const": "REVOKED" } } },
          "then": { "required": ["revokedAt", "revocationReason"] }
        }
      ]
    },

    "logKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "alg", "publicKey", "status", "validFrom"],
      "properties": {
        "kid": { "$ref": "#/$defs/logKid" },
        "alg": { "const": "Ed25519" },
        "publicKey": { "$ref": "#/$defs/spki" },
        "status": { "enum": ["ACTIVE", "RETIRED", "REVOKED"] },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "lastTreeSize": { "$ref": "#/$defs/treeSize" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ACTIVE" } } },
          "then": { "not": { "anyOf": [{ "required": ["validUntil"] }, { "required": ["lastTreeSize"] }] } }
        },
        {
          "if": { "properties": { "status": { "const": "RETIRED" } } },
          "then": { "required": ["validUntil", "lastTreeSize"] }
        },
        {
          "if": { "properties": { "status": { "const": "REVOKED" } } },
          "then": { "required": ["validUntil"] }
        }
      ]
    },

    "logKeyDocument": {
      "description": "GET /api/.well-known/cmdash-proof-log/key.json, and the log member of a key document (spec section 7.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "v", "generatedAt", "origin", "keys"],
      "properties": {
        "format": { "const": "cmdash-proof-log-keys" },
        "v": { "const": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "origin": { "$ref": "#/$defs/origin" },
        "keys": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/logKeyEntry" } }
      }
    },

    "keyDocument": {
      "description": "GET <deployment>/api/.well-known/cmdash-proof-keys/<tenantRef>.json (spec section 6.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "v", "deployment", "tenantRef", "generatedAt", "keys"],
      "properties": {
        "format": { "const": "cmdash-proof-keys" },
        "v": { "const": 0 },
        "deployment": { "$ref": "#/$defs/issuingDeployment" },
        "tenantRef": { "$ref": "#/$defs/tenantRef" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "keys": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/issuerKeyEntry" } },
        "log": { "$ref": "#/$defs/logKeyDocument" }
      }
    },

    "manifest": {
      "description": "The committed evidence manifest (spec section 8.1): a header that must describe the receipt, and the Merkle root of the salted items.",
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "issuer", "claimId", "observedAt", "itemCount", "itemsRoot"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/ulid" },
        "issuer": { "$ref": "#/$defs/issuer" },
        "claimId": { "$ref": "#/$defs/claimId" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "itemCount": { "$ref": "#/$defs/treeSize" },
        "itemsRoot": { "$ref": "#/$defs/hex32" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator", "unknown"],
          "properties": {
            "numerator": { "$ref": "#/$defs/count" },
            "denominator": { "$ref": "#/$defs/count" },
            "unknown": { "$ref": "#/$defs/count" }
          }
        },
        "method": { "$ref": "#/$defs/method" },
        "selfAttested": { "$ref": "#/$defs/selfAttested" }
      },
      "oneOf": [
        { "required": ["counts", "method"], "not": { "required": ["selfAttested"] } },
        { "required": ["selfAttested"], "not": { "anyOf": [{ "required": ["counts"] }, { "required": ["method"] }] } }
      ]
    },

    "evidenceOpening": {
      "description": "A disclosed evidence commitment opening (spec section 8.2). Shared only with the issuer's explicit consent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "v", "receiptId", "salt", "manifest"],
      "properties": {
        "format": { "const": "cmdash-evidence-opening" },
        "v": { "const": 0 },
        "receiptId": { "$ref": "#/$defs/ulid" },
        "salt": { "$ref": "#/$defs/hex32" },
        "manifest": { "$ref": "#/$defs/manifest" }
      }
    },

    "evidenceItem": {
      "description": "One sampled evidence item and its inclusion proof under the manifest itemsRoot (spec section 8.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "v", "receiptId", "index", "itemCount", "salt", "item", "proof"],
      "properties": {
        "format": { "const": "cmdash-evidence-item" },
        "v": { "const": 0 },
        "receiptId": { "$ref": "#/$defs/ulid" },
        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "itemCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "salt": { "$ref": "#/$defs/hex32" },
        "item": { "type": "object" },
        "proof": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/hex32" } }
      }
    },
    "attestationItem": {
      "description": "Item 0 of a self-attested receipt's evidence (spec section 5.2): the attestation record, exactly { statement, userId }, whose statement is the receipt's claim.statement. A schema cannot compare the two; the checker's item.attestation rule does.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "userId"],
      "properties": {
        "statement": { "$ref": "#/$defs/text", "maxLength": 500 },
        "userId": { "$ref": "#/$defs/userId" }
      }
    },
    "logSection": {
      "description": "An inclusion proof and the checkpoint it leads to (spec section 7.2): the envelope's log member, or a log section the relying party supplies (spec section 7.6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "treeSize", "rootHash", "proof", "checkpoint"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "treeSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "rootHash": { "$ref": "#/$defs/hex32" },
        "proof": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/hex32" } },
        "checkpoint": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    }
  }
}
